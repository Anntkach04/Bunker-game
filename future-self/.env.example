# Server port
PORT=4000

# Public base URL used to build dashboard magic links in emails
APP_BASE_URL=http://localhost:5173

# Email delivery.
# If SMTP_HOST is set, real emails are sent via SMTP (e.g. Mailgun, SendGrid, Postmark, Gmail).
# If SMTP_HOST is NOT set, the app runs in PREVIEW mode: newsletters are fully composed and
# stored (viewable in the dashboard "Inbox") but not delivered to a real inbox. This lets you
# develop and demo the whole pipeline with zero credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASS=your-pass

# From address for outgoing newsletters
MAIL_FROM="Your Future Self <future@futureself.local>"

# Cron expression for the scheduler tick (default: every minute)
SCHEDULER_CRON=* * * * *
